# --- byte-compiled / env -------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.DS_Store

# --- never commit model weights -----------------------------------------
*.safetensors
*.bin
*.pt
*.pth
*.gguf
hf_cache/
models/

# --- benchmark output ----------------------------------------------------
# Raw runs are large and machine-specific. Only curated, committed-on-purpose
# results under results/published/ enter git.
results/*
!results/published/
!results/.gitkeep
*.ncu-rep
*.nsys-rep
*.qdrep

# --- plots ---------------------------------------------------------------
# Regenerated from the CSVs on every run, so tracking them means binary churn
# on each sweep. publish_results.sh copies the relevant ones into
# results/published/<label>/ so a kept result set carries its own figures.
plots/

# --- traces --------------------------------------------------------------
# Captured routing histograms ARE committed: they are kilobytes and they are
# the point of the project. Raw router logits are not.
traces/raw/
*.logits.npz

# --- triton / cuda caches ------------------------------------------------
.triton/
*.cubin
*.ptx
*.so

# --- stray notebooks ------------------------------------------------------
# An empty Untitled.ipynb was committed by accident in 66d4d53 and lived in the
# repo root for a week. Jupyter names them this by default, so the default name
# is the one to catch.
Untitled*.ipynb
